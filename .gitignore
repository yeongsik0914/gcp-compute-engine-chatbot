# =================================================================
# .gitignore for Gemini Chatbot & GCP Compute Engine Project
# =================================================================

# 1. API Keys, Secrets & Environment Variables (최우선 차단)
.env
.env.*
*.env
!.env.example
.flaskenv
secrets/
*.secret

# 2. GCP & Cloud Provider Credentials (서비스 계정 키 및 인증 정보)
*service_account*.json
*service-account*.json
*credentials*.json
*credential*.json
client_secret*.json
client_secrets*.json
application_default_credentials.json
*-key.json
gcp_key.json
gcp-key.json
adc.json
.gcloud/

# 3. SSL/TLS Certificates & Private Keys (인증서 및 개인키)
*.pem
*.key
*.crt
*.cer
*.csr
*.pfx
*.p12
*.der
*.cert

# 4. SSH Keys & Remote Access Keys (SSH 접속 키)
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
id_dsa
id_dsa.pub
*.ppk
known_hosts
authorized_keys

# 5. Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints/
*-checkpoint.ipynb
.jupyter/

# 6. Python Cache & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# 7. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 8. Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.mypy_cache/
nosetests.xml
coverage.xml

# 9. IDEs & Text Editors Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.fleet/

# 10. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 11. Temporary Files & Logs
*.log
logs/
*.tmp
*.temp
.cache/
*.bak
*.swp
*.orig

# 12. Local SQLite & Temporary Databases
*.sqlite3
*.db
